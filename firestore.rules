// Firestore 보안 규칙 — Firebase 콘솔 → Firestore Database → 규칙 에 붙여넣고 [게시]
//
// firebaseConfig는 공개 식별자라 누구나 볼 수 있습니다.
// 실제 접근 통제는 전적으로 이 규칙이 담당하므로, 허용 이메일을 정확히 관리해야 합니다.
//
// ALLOWED 목록에 없는 계정은 로그인에 성공해도 읽기·쓰기가 모두 거부됩니다.
// (앱에서는 CloudBar에 "⚠ 접근 권한 없음"으로 표시됩니다.)

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          // 이 앱을 쓸 구글 계정 목록. 마지막 항목 뒤에는 쉼표를 붙이지 않는다.
          // 사람이 빠지면 여기서 지우고 콘솔에 다시 게시한다.
          'quddnr7201@gmail.com',
          'alphamns6693@gmail.com',
          'jiany670@gmail.com'
        ];
    }

    // 앱이 쓰는 문서는 sync/diagnostic-assessment 하나뿐입니다.
    match /sync/{docId} {
      allow read, write: if allowed();
    }

    // 그 외 경로는 모두 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// Storage 보안 규칙 — Firebase 콘솔 → Storage → 규칙 에 붙여넣고 [게시]
//
// 시험지에 직접 올린 문제지·해설·출제표가 여기에 담깁니다.
// Firestore 문서는 1MB가 한도라 PDF가 들어가지 않아 파일만 따로 둡니다.
// 시험지에는 경로(짧은 문자열)만 적히고, 그 경로는 Firestore로 동기화됩니다.
//
// 허용 이메일 목록은 firestore.rules 와 똑같이 맞춰야 합니다.
// 한쪽만 고치면 데이터는 동기화되는데 파일만 안 보이는 상태가 됩니다.

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          // firestore.rules 의 목록과 같아야 한다.
          // 마지막 항목 뒤에는 쉼표를 붙이지 않는다.
          'quddnr7201@gmail.com',
          'alphamns6693@gmail.com',
          'jiany670@gmail.com'
        ];
    }

    // 앱이 쓰는 경로는 sync/<문서이름>/<시험지id>/<종류> 하나뿐입니다.
    // 실수로 큰 파일이 올라가 요금이 새지 않도록 한 개 20MB로 막습니다.
    match /sync/{docId}/{examId}/{kind} {
      allow read: if allowed();
      allow write: if allowed() && request.resource.size < 20 * 1024 * 1024;
      allow delete: if allowed();
    }

    // 그 외 경로는 모두 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
